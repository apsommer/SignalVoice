getCLmessage() =>
    string message = na

    if isOpenGap
        message :=
             "Gap • " +
             (isOpenGapUp ? "Upside opening shock • " : "Downside opening shock • ") +
             formattedCascadeTicks

    if triggerStopCascade and not (isContinuationCascadeUp or isContinuationCascadeDown)
        message :=
             "Cascade • " +
             (isStopCascadeUp ? "Short squeeze • " : "Long liquidation • ") +
             formattedCascadeTicks

    else if triggerContinuationCascade
        message :=
             "Cascade • " +
             (isContinuationCascadeUp ? "Upside continuation • " : "Downside continuation • ") +
             formattedCascadeTicks

    else if triggerExpansionEvent
        message :=
             "Inventory shock • " +
             (isUp ? "Bullish imbalance • " : "Bearish imbalance • ") +
             formattedMagnitude

    else if triggerExhaustionEvent
        message :=
             "Exhaustion • " +
             (expansionDirection ? "Upside impulse fading • " : "Downside impulse fading • ") +
             formattedMagnitude

    else if triggerRangeBreakoutEvent
        message :=
             "Compression • " +
             (eventDirectionUp ? "Upside release • " : "Downside release • ") +
             formattedMagnitude

    else if isAcceptanceTriggerUp
        message := "Acceptance • Upside holding • " + formattedMagnitude

    else if isAcceptanceTriggerDown
        message := "Acceptance • Downside holding • " + formattedMagnitude

    else if isRejectionTriggerUp or isRejectionTriggerDown
        message := "Failure • Return to balance • " + formattedMagnitude

    else if triggerSlowTrendUp
        message := "Inventory • Bullish pressure • " + formattedMagnitude

    else if triggerSlowTrendDown
        message := "Inventory • Bearish pressure • " + formattedMagnitude

    else
        message := na

    message

// alert message
newMessage :=
     isZN ? getZNmessage() :
     isNQ ? getNQmessage() :
     isBTC ? getBTCmessage() :
     isES ? getESmessage() :
     isE6 ? getE6message() :
     isCL ? getCLmessage() : na

if not na(newMessage)
    alertMessage := newMessage

// hard constraint to prevent duplicate alerts
shouldFireAlert =
     triggerExpansionEvent
     or triggerStopCascade
     or triggerContinuationCascade
     or triggerExhaustionEvent
     or triggerRangeBreakoutEvent
     or isAcceptanceTriggerUp
     or isAcceptanceTriggerDown
     or isRejectionTriggerUp
     or isRejectionTriggerDown

// close of bar signals
isCloseEvaluatedAlert =
     triggerStopCascade
     or triggerContinuationCascade
     or triggerSlowTrendUp
     or triggerSlowTrendDown
     or isOpenGap

// send alert to webhook
if shouldFireAlert and not na(alertMessage) and (barstate.isconfirmed or not isCloseEvaluatedAlert)
    alert(alertMessage, alert.freq_once_per_bar)