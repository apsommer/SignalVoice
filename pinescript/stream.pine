getE6message() =>
    string message = na

    if isOpenGap
        message :=
             "Gap • " +
             (isOpenGapUp ? "Euro opening repricing • " : "Dollar opening repricing • ") +
             formattedCascadeTicks

    if triggerStopCascade and not (isContinuationCascadeUp or isContinuationCascadeDown)
        message :=
             "Flow • " +
             (isStopCascadeUp ? "Aggressive euro repricing • " : "Aggressive dollar repricing • ") +
             formattedCascadeTicks

    else if triggerContinuationCascade
        message :=
             "Flow • " +
             (isContinuationCascadeUp ? "Euro continuation buying • " : "Dollar continuation buying • ") +
             formattedCascadeTicks

    else if triggerExpansionEvent
        message :=
             "Currency expansion • " +
             (isUp ? "Euro strength expanding • " : "Dollar strength expanding • ") +
             formattedMagnitude

